# Copy to .env and fill in. Docker Compose picks .env up automatically.
#
# .env is git-ignored; .env.example is the checked-in template and must never
# contain a real value.

# JWT signing key: at least 32 characters, and treat it like any other credential.
#
# Leave it unset for local work - the container runs in Development and generates a
# random key each start, which is safer than a shared one. Set it when you need
# tokens to survive a restart, and always set it anywhere that is not a laptop.
#
# Generate one:
#   openssl rand -base64 48
#   dotnet user-secrets set "Jwt:SigningKey" "$(openssl rand -base64 48)" \
#     --project src/Mazza.Orders.Api
JWT_SIGNING_KEY=

# SonarQube project token, only needed for the `sonar` compose profile.
SONAR_TOKEN=
SONAR_PROJECT_KEY=mazza-orders
